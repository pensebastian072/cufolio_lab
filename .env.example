# Optional overrides (all have sane defaults in cufolio_lab/config.py).
# Path to HQ's daily-returns artifact (default: ../hq-trading-system/journal/portfolio/daily_returns.json)
# HQ_DAILY_RETURNS=
# Input freshness window in hours before falling back to static weights (default 36)
# CUFOLIO_INPUT_STALE_HOURS=36
# Per-cell active-days gate for the data-driven method (default 10)
# CUFOLIO_MIN_ACTIVE_DAYS=10
